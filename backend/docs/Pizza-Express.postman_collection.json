				{
					"name": "Login do administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const resposta = pm.response.json();",
									"const token = resposta.token || resposta.data?.token || resposta.data?.accessToken;",
									"if (token) pm.collectionVariables.set('token', token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@pizzaexpress.com\",\n  \"password\": \"senha\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/auth/login"
					}
				},
				{
					"name": "Renovar sessão",
